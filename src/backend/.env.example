# Copy to .env. Never commit actual keys. All settings live on the backend.
OPENAI_API_KEY=
# Requires Responses web_search, function calling and structured output support; no local model.
OPENAI_MODEL=gpt-4.1-mini
MAX_SEARCH_CALLS=3
MAX_SOURCES=10
# Total pages per exploration, including follow-ups. Start a new search at the limit.
MAX_SESSION_SOURCES=40
JOB_TIMEOUT_SECONDS=90
REQUEST_TIMEOUT_SECONDS=20
EXTERNAL_RETRIES=1
# Recent user replies and agent questions retained in a signed continuation.
MAX_CONTEXT_TURNS=12
MAX_MODEL_TURNS=8
MAX_OUTPUT_TOKENS=4000
MAX_REQUEST_BYTES=2100000
MAX_CONCURRENT_JOBS=4
REQUESTS_PER_MINUTE=10
JOB_TTL_SECONDS=1800
MAX_STORED_JOBS=100
# Required persistent random 32+ character key in production for signed continuation data.
SESSION_SIGNING_KEY=
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8018
FRONTEND_PORT=5178

# Source/evidence diagnostics (also enabled automatically under the Python debugger).
DEBUG_DIAGNOSTICS=false
