# Copy to .env. Never commit actual keys. All settings live on the backend.
OPENAI_API_KEY=
# General Agents SDK model using Responses streaming. No tools enabled.
OPENAI_MODEL=gpt-4.1-mini
# Independent lightweight model for conversation titles.
OPENAI_BACKGROUND_MODEL=gpt-4o-mini
BACKGROUND_TIMEOUT_SECONDS=15
JOB_TIMEOUT_SECONDS=90
REQUEST_TIMEOUT_SECONDS=20
# Recent completed user/assistant turns retained in a signed continuation.
MAX_CONTEXT_TURNS=12
MAX_MODEL_TURNS=1
MAX_OUTPUT_TOKENS=4000
MAX_REQUEST_BYTES=2100000
MAX_CONCURRENT_JOBS=4
REQUESTS_PER_MINUTE=10
JOB_TTL_SECONDS=1800
MAX_STORED_JOBS=100
# Required persistent random 32+ character key in production for signed continuation data.
SESSION_SIGNING_KEY=
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8018
FRONTEND_PORT=5178

# Agent streaming metadata diagnostics (also enabled automatically under the Python debugger).
DEBUG_DIAGNOSTICS=false
