# Copy to .env. Never commit actual keys. All settings live on the backend.
OPENAI_API_KEY=
# General Agents SDK model using Responses streaming and bounded function tools.
OPENAI_MODEL=gpt-4.1-mini
# Web-search-capable Responses model. One hosted search per web_search invocation.
OPENAI_SEARCH_MODEL=gpt-4.1-mini
OPENAI_STRUCTURE_MODEL=gpt-4.1-mini
STRUCTURE_TIMEOUT_SECONDS=25
# Independent lightweight model for conversation titles.
OPENAI_BACKGROUND_MODEL=gpt-4o-mini
BACKGROUND_TIMEOUT_SECONDS=15
JOB_TIMEOUT_SECONDS=90
REQUEST_TIMEOUT_SECONDS=20
# Recent completed user/assistant turns retained in a signed continuation.
MAX_CONTEXT_TURNS=12
MAX_MODEL_TURNS=6
MAX_TOOL_CALLS=8
MAX_WEB_SEARCHES=2
# Maximum source cards sent for each completed/partial answer.
MAX_RESPONSE_SOURCES=5
TOOL_TIMEOUT_SECONDS=20
MAX_PAGE_BYTES=1000000
MAX_PAGE_CHARS=16000
MAX_OUTPUT_TOKENS=4000
MAX_REQUEST_BYTES=2100000
MAX_CONCURRENT_JOBS=4
REQUESTS_PER_MINUTE=10
JOB_TTL_SECONDS=1800
MAX_STORED_JOBS=100
# Required persistent random 32+ character key in production for signed continuation data.
SESSION_SIGNING_KEY=
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8018
FRONTEND_PORT=5178

# Agent streaming metadata diagnostics (also enabled automatically under the Python debugger).
DEBUG_DIAGNOSTICS=false

# Maximum concurrent source page reads within the existing request/tool budget.
MAX_SOURCE_CONCURRENCY=3
# Per-page summaries; only fetched text is sent, once per displayed page.
OPENAI_SOURCE_SUMMARY_MODEL=gpt-4.1-mini
MAX_SOURCE_SUMMARIES=5
SOURCE_SUMMARY_TIMEOUT_SECONDS=15
# Wire bytes remain bounded by MAX_PAGE_BYTES; gzip decoding has a separate ceiling.
MAX_PAGE_DECODED_BYTES=4000000

# Image supplement per request, within total tool budget.
MAX_IMAGE_SEARCHES=1
